{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chambeasimple-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-14",
  // workers.dev stays on for previews (each PR gets pr-<n>-…); production moves to chambasimple.com.
  // Production on the real domain (needs the zone active in Cloudflare). www only redirects.
  "routes": [
    { "pattern": "chambasimple.com", "custom_domain": true },
    { "pattern": "www.chambasimple.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /en.html → /en, /casos/x/ → /casos/x: one URL per page, as in the sitemap.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Only page routes run the Worker (Markdown, headers, measurement): on the free plan every run
    // counts against 100k requests a day; files never do. worker/index.test.ts checks the list.
    // ponytail: past ~100k page views a day, Workers Paid (5 USD/month) or fewer Worker routes.
    "run_worker_first": ["/", "/en", "/en/*", "/casos/*", "/privacidad"]
  },
  // Cookieless page views (worker/index.ts, pointOf). Free tier: 100k data points a day.
  "analytics_engine_datasets": [{ "binding": "VISITS", "dataset": "chambeasimple_visits" }],
  "observability": { "enabled": true }
}
