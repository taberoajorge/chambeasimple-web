---
import { en as t } from '../../content/en.ts';
import { PATHS, pageTitle } from '../../content/site.ts';
import Base from '../../layouts/Base.astro';
import Privacy from '../../sections/Privacy.astro';
---

<Base t={t} lang="en" title={pageTitle(t.privacy.title)} description={t.privacy.description} paths={{ es: PATHS.es.privacy, en: PATHS.en.privacy }} schema={{ '@context': 'https://schema.org', '@type': 'WebPage', name: t.privacy.title }}>
  <Privacy t={t} />
</Base>
