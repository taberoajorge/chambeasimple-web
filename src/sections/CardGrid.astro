---
// The list that holds Cards. Columns grow with the screen.
interface Props {
  cols: 2 | 3;
}

const { cols } = Astro.props;
// Literal class names, so Tailwind sees them.
const COLS = {
  2: 'md:grid-cols-2',
  3: 'md:grid-cols-2 lg:grid-cols-3',
};
---

<ul class:list={['mt-10 grid gap-x-4 gap-y-4', COLS[cols]]}><slot /></ul>
