---
import type { Content } from '../content/es.ts';

interface Props {
  t: Content;
}

const { t } = Astro.props;
---

<article class="mx-auto max-w-3xl px-5 py-12 md:px-8 md:py-20">
  <h1 class="text-4xl font-extrabold tracking-tight md:text-5xl">{t.privacy.title}</h1>
  <p class="mt-3 text-sm text-muted">{t.privacy.updated} {t.privacy.draft}</p>
  {
    t.privacy.sections.map((s) => (
      <section>
        <h2 class="mt-10 text-2xl font-extrabold tracking-tight">{s.title}</h2>
        <p class="mt-3 text-lg">{s.body}</p>
      </section>
    ))
  }
</article>
